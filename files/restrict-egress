def write_file(path, content, mode):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d)
    with os.fdopen(fd, "w") as f:
        f.write(content)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def self_install():
    """Root-run units execute INSTALL_PATH: content AND ownership/mode are
    enforced every time, not only when the copy is missing."""
    src = os.path.realpath(sys.argv[0])
    with open(src, "rb") as f:
        content = f.read()
    current = None
    try:
        with open(INSTALL_PATH, "rb") as f:
            current = f.read()
    except OSError:
        pass
    if current != content:
        d = os.path.dirname(INSTALL_PATH)
        fd, tmp = tempfile.mkstemp(dir=d)
        with os.fdopen(fd, "wb") as f:
            f.write(content)
        os.chmod(tmp, 0o755)
        os.replace(tmp, INSTALL_PATH)
        if src != os.path.realpath(INSTALL_PATH):
            log(f"installed to {INSTALL_PATH} (boot units reference this path)")
    os.chown(INSTALL_PATH, 0, 0)
    os.chmod(INSTALL_PATH, 0o755)


# ----------------------------------------------------------------- guards ----

def require_root():
    if os.geteuid() != 0:
        sys.exit("error: this command must run as root")


def systemd_running():
    return os.path.isdir("/run/systemd/system")


def require_nft():
    if shutil.which("nft", path=SAFE_ENV["PATH"]) is None:
        sys.exit("error: nft not found; install the nftables package")


def require_nft_operable():
    """nft present AND usable in this namespace. Root is not sufficient: a
    container needs CAP_NET_ADMIN. Probe explicitly so container commands fail
    loudly instead of silently mis-reporting (a failed nft query must never be
    read as 'no table')."""
    require_nft()
    if run(["nft", "list", "tables"], check=False).returncode != 0:
        sys.exit("error: nft cannot access the ruleset; a container needs "
                 "--cap-add=NET_ADMIN (and an nft-capable host kernel)")


def require_environment():
    """The persistent path (on/refresh) needs systemd; without it, point the
    user at the container one-shot instead of failing blankly."""
    if not systemd_running():
        sys.exit("error: systemd is not running; for a container use "
                 "'restrict-egress apply' (one-shot, no persistence; run the "
                 "container with --cap-add=NET_ADMIN)")
    require_nft()


# ----------------------------------------------------------------- reload ----

def do_reload(conf_path, no_allowlist):
    """Regenerate and apply the full ruleset from the current config.
    Caller holds the lock. Fail-safe: a broken config never widens the
    boundary; with no table (or stale uplinks) it produces a fail-closed
    baseline rather than leaving a gap."""
    uplinks = detect_uplinks()
    prior = read_state()
    try:
        cfg, conf_sha = load_config(conf_path, no_allowlist)
    except (ConfigError, OSError) as e:
        # Missing/untrusted state counts as stale: without it we cannot confirm
        # the running table was built for the current uplinks, and keeping a
        # table whose 'oifname != {old}' rule predates a route move would leave
        # the new uplink unrestricted. Fail closed to a baseline for the uplinks
        # we can see now instead.
        stale = (not prior) or prior.get("uplinks") != uplinks
        if table_exists() and chain_enforcing() and not stale:
            log(f"config unusable ({e}); keeping the existing ruleset", error=True)
            return False
        log(f"config unusable ({e}); loading fail-closed baseline", error=True)
        baseline = Config()
        baseline.dns_open = False
        nft_apply(generate_ruleset(baseline, uplinks, set()))
        # Clear recorded allowances so status reflects the baseline (deny all),
        # not the last good config; empty sha forces a reload next tick.
        write_state(conf_path, "", no_allowlist, uplinks,
                    (prior or {}).get("refresh_s") or DEFAULT_REFRESH_S, [], [])
        return False
    if not table_exists():
        # Deny is in place while resolution runs; a slow resolver never
        # leaves the boot path unprotected.
        nft_apply(generate_ruleset(cfg, uplinks, set()))
    elements, failed, provenance = resolve_domains(cfg.domains)
    if failed:
        log(f"could not resolve: {', '.join(failed)} (will retry on next refresh)", error=True)
    nft_apply(generate_ruleset(cfg, uplinks, elements))
    # Full reload replaces the whole table, so provenance is replaced, not
    # merged: only what we just resolved is live.
    write_state(conf_path, conf_sha, no_allowlist, uplinks, cfg.refresh_s,
                resolved_records(provenance, cfg.timeout_s, time.time()), cidr_records(cfg))
    if os.path.exists(UNIT_TIMER) and (not prior or prior.get("refresh_s") != cfg.refresh_s):
        write_file(UNIT_TIMER, unit_timer(cfg.refresh_s), 0o644)
        run(["systemctl", "daemon-reload"], check=False)
        run(["systemctl", "restart", "restrict-egress-refresh.timer"], check=False)
    log(f"ruleset loaded: uplinks={','.join(uplinks) or 'NONE(fail-closed)'} "
        f"allowed={len(elements)} resolved + {len(cfg.cidrs)} static, "
        f"dns={'open' if cfg.dns_open else 'closed'}")
    return True


def cmd_refresh(args):
    require_root()
    require_environment()
    with Lock():
        state = read_state()
        no_allowlist = bool(state and state.get("no_allowlist"))
        conf_path = args.config
        if args.reload:
            ok = do_reload(conf_path, no_allowlist)
            sys.exit(0 if ok else 1)
        # Self-heal: anything structural drifted -> full reload.
        drift = None
        if state is None:
            drift = "no recorded state"
        elif not table_exists():
            drift = "table missing"
        elif not chain_enforcing():
            drift = "output chain missing or not default-deny"
        elif detect_uplinks() != state.get("uplinks"):
            drift = "default-route interfaces changed"
        elif state.get("version") != VERSION:
            # A plain refresh never fills state fields a new version added (e.g.
            # a CIDR-only config resolves no elements, so cmd_refresh's write is
            # skipped); force one full reload after an upgrade to repopulate.
            drift = "tool version changed"
        else:
            try:
                if hashlib.sha256(read_config_bytes(conf_path)).hexdigest() != state.get("config_sha256"):
                    drift = "config changed"
            except (ConfigError, OSError):
                drift = "config unreadable or unsafe"
        if drift:
            log(f"refresh: {drift}; reloading ruleset")
            sys.exit(0 if do_reload(conf_path, no_allowlist) else 1)
        try:
            cfg, conf_sha = load_config(conf_path, no_allowlist)
        except (ConfigError, OSError) as e:
            log(f"refresh: config unusable ({e}); keeping current state", error=True)
            sys.exit(1)
        elements, failed, provenance = resolve_domains(cfg.domains)
        if failed:
            log(f"could not resolve: {', '.join(failed)}", error=True)
        if elements:
            # destroy+add in one batch guarantees the timeout is renewed;
            # a plain re-add of a live element is not specified to renew it.
            batch = []
            for ip, port in sorted(elements):
                batch.append(f"destroy element {TABLE} {SET_NAME} {{ {ip} . {port} }}")
                batch.append(f"add element {TABLE} {SET_NAME} {{ {ip} . {port} }}")
            run(["nft", "-f", "-"], input_text="\n".join(batch) + "\n")
            # Merge (not replace): rotated-out IPs stay live until their nft
            # timeout, so their attribution must persist alongside this tick's.
            merged = merge_resolved((state or {}).get("resolved", []),
                                    provenance, cfg.timeout_s, time.time())
            write_state(conf_path, conf_sha, no_allowlist,
                        (state or {}).get("uplinks", []), cfg.refresh_s, merged, cidr_records(cfg))
            log(f"refreshed {len(elements)} allowlist elements")


# --------------------------------------------------------------- on / off ----

def enabled_units():
    return ["restrict-egress.service", "restrict-egress-refresh.timer"]


def teardown(quiet=False):
    # Systemd cleanup only where systemd runs; in a container there are no units.
    # Guarded on systemd_running() (not systemctl presence) so a systemd host with
    # systemctl somehow missing keeps its prior behavior rather than silently
    # leaving units active -- only a genuine no-systemd container skips this.
    if systemd_running():
        for unit in enabled_units() + ["restrict-egress-refresh.service"]:
            run(["systemctl", "disable", "--now", unit], check=False)
    for path in (UNIT_BOOT, UNIT_REFRESH, UNIT_TIMER, DISPATCHER_HOOK, STATE_PATH):
        try:
            os.unlink(path)
        except OSError:
            pass
    try:
        os.rmdir(STATE_DIR)
    except OSError:
        pass
    if systemd_running():
        run(["systemctl", "daemon-reload"], check=False)
    run(["nft", "delete", "table"] + TABLE.split(), check=False)
    if not quiet:
        log("egress restrictions removed; outbound access is unrestricted")


def cmd_on(args):
    if args.dry_run:
        return dry_run(args)
    require_root()
    require_environment()
    conf_path = os.path.abspath(args.config)
    if UNSAFE_PATH_RE.search(conf_path):
        sys.exit("error: config path contains characters unsafe for systemd units "
                 "(whitespace, quotes, %, or shell metacharacters); use a plainer path")
    try:
        cfg, _ = load_config(conf_path, args.no_allowlist)
    except (ConfigError, OSError) as e:
        sys.exit(f"error: {e}")
    with Lock():
        was_active = table_exists()
        try:
            self_install()
            write_file(UNIT_BOOT, unit_boot(conf_path), 0o644)
            write_file(UNIT_REFRESH, unit_refresh(conf_path), 0o644)
            write_file(UNIT_TIMER, unit_timer(cfg.refresh_s), 0o644)
            if os.path.isdir(os.path.dirname(DISPATCHER_DIR)):
                write_file(DISPATCHER_HOOK, dispatcher_hook(conf_path), 0o755)
            else:
                log("warning: networkd-dispatcher not present; relying on boot unit and timer", error=True)
            run(["systemctl", "daemon-reload"])
            run(["systemctl", "enable"] + enabled_units())
            run(["systemctl", "start", "restrict-egress-refresh.timer"])
            if not do_reload(conf_path, args.no_allowlist):
                raise RuntimeError("initial ruleset load failed; see log")
        except (subprocess.CalledProcessError, RuntimeError, OSError) as e:
            detail = getattr(e, "stderr", "") or str(e)
            if was_active:
                # Never convert a failed re-run into unrestricted egress.
                sys.exit(f"error: re-enable failed ({detail.strip()}); the previously "
                         "active lockdown was left in place — check 'restrict-egress status'")
            teardown(quiet=True)
            sys.exit(f"error: enable failed, everything rolled back: {detail.strip()}")
    # Outside the lock: the unit's own refresh --reload takes the same flock.
    started = run(["systemctl", "start", "restrict-egress.service"], check=False)
    if started.returncode != 0:
        log("warning: boot service failed to start; check 'systemctl status "
            "restrict-egress' before relying on reboot persistence", error=True)
    log("egress lockdown active and persistent; verify with: restrict-egress status")


def cmd_off(args):
    require_root()
    require_nft_operable()
    with Lock():
        teardown()
        leftovers = []
        if table_exists():
            leftovers.append("nft table still loaded")
        leftovers += [p for p in (UNIT_BOOT, UNIT_REFRESH, UNIT_TIMER, DISPATCHER_HOOK)
                      if os.path.exists(p)]
        if leftovers:
            sys.exit("error: removal incomplete: " + "; ".join(str(x) for x in leftovers))


# --------------------------------------------------------------- container ----

def cmd_apply(args):
    """Container one-shot: apply the ruleset in the current network namespace
    with no systemd persistence and no refresh. Intended for restricting a
    container's own egress (e.g. around the REMnux MCP server) with a static
    IP/CIDR allowlist. Needs NET_ADMIN. The VM path (on/off/refresh) is
    unaffected; this is a separate, additive entry point."""
    if args.dry_run:
        return dry_run(args, container=True)
    require_root()
    # A systemd-managed lockdown shares this table AND state; if 'apply' replaced
    # them, the boot unit and timer would adopt apply's config and keep
    # refreshing/restoring it -- neither "one-shot" nor "no persistence". Refuse.
    if os.path.exists(UNIT_BOOT) or os.path.exists(UNIT_TIMER):
        sys.exit("error: a persistent lockdown is installed (via 'on'); run "
                 "'restrict-egress off' first. On a VM or host, use 'on', not 'apply'.")
    require_nft_operable()
    conf_path = os.path.abspath(args.config)
    try:
        cfg, conf_sha = load_config(conf_path, args.no_allowlist)
    except (ConfigError, OSError) as e:
        sys.exit(f"error: {e}")
    with Lock():
        # Container mode restricts every interface (restrict_all): no refresh runs
        # to re-detect a moved default route, so uplink-scoped rules could fail
        # open. uplinks recorded for status only, not for enforcement.
        uplinks = detect_uplinks()
        elements, failed, provenance = resolve_domains(cfg.domains)
        if failed:
            log(f"could not resolve: {', '.join(failed)}", error=True)
        try:
            nft_apply(generate_ruleset(cfg, uplinks, elements, restrict_all=True))
        except subprocess.CalledProcessError as e:
            detail = (getattr(e, "stderr", "") or str(e)).strip()
            sys.exit(f"error: could not load ruleset ({detail}); a container needs "
                     "--cap-add=NET_ADMIN and an nft-capable host kernel")
        # The ruleset is committed and enforcing at this point. A failed state
        # write (e.g. read-only /var/lib) must NOT abort with the firewall up:
        # warn and continue, degrading status to unlabeled IPs.
        try:
            write_state(conf_path, conf_sha, args.no_allowlist, uplinks, cfg.refresh_s,
                        resolved_records(provenance, cfg.timeout_s, time.time()), cidr_records(cfg))
        except OSError as e:
            log(f"warning: ruleset applied but state not written ({e}); status will "
                "show live IPs without domain labels", error=True)
    if cfg.domains:
        log(f"warning: 'apply' does not refresh; domain entries stop working once "
            f"their {cfg.timeout_s}s timeout lapses (fails closed). Use IP/CIDR "
            f"entries in a container, or re-run 'apply' to re-resolve.", error=True)
    log(f"egress ruleset applied in this namespace (container mode, all interfaces "
        f"restricted, no persistence); allowed={len(elements)} resolved + "
        f"{len(cfg.cidrs)} static. Enable before untrusted code runs; "
        f"remove with 'restrict-egress off'.")


# ------------------------------------------------------------------ status ----

def print_allowed(live, live_elems, state):
    """Show what egress is actually permitted right now: resolved domains
    grouped by name (recorded provenance intersected with the live set, so only
    enforced IPs appear and stale records drop), then static CIDRs, then any
    live IP with no recorded provenance. Reads no DNS -- the answer is what is
    enforced, not what a name resolves to at this instant."""
    cidrs = (state or {}).get("cidrs", []) if live else []
    if not live or not (live_elems or cidrs):
        return
    by_dom, ip_owners, covered = {}, {}, set()
    for rec in (state or {}).get("resolved", []):
        key = (rec["ip"], int(rec["port"]))
        if key not in live_elems:
            continue
        by_dom.setdefault((rec["name"], key[1]), set()).add(rec["ip"])
        ip_owners.setdefault(key, set()).add(rec["name"])  # distinct owners, so dup records never fake (shared)
        covered.add(key)
    print("currently allowed:")
    for name, port in sorted(by_dom):
        print(f"   {name}:{port}")
        for ip in sorted(by_dom[(name, port)], key=ipaddress.ip_address):
            shared = "  (shared)" if len(ip_owners.get((ip, port), ())) > 1 else ""
            print(f"     {ip}{shared}")
    for net, port in cidrs:
        print(f"   {net}:{port}  (static CIDR)")
    for ip, port in sorted(live_elems - covered, key=lambda t: (ipaddress.ip_address(t[0]), t[1])):
        print(f"   {ip}:{port}  (provenance unavailable)")


def status_container(brief):
    """Status without systemd: there are no units or timer to check, so report
    only what is enforced in this namespace. nft listing needs root, so a
    non-root caller cannot determine active/inactive -- say so rather than
    reporting a false 'inactive'."""
    if os.geteuid() != 0:
        print("restrict-egress: run as root to query enforcement in container mode")
        sys.exit(4)
    require_nft_operable()
    live = table_exists() and chain_enforcing()
    verdict, code = ("active", 0) if live else ("inactive", 3)
    if brief:
        print(f"restrict-egress: {verdict} (container mode)")
        sys.exit(code)
    print(f"restrict-egress: {verdict} (container mode, no systemd persistence)")
    print(f"  [{'ok' if live else '--'}] nftables ruleset loaded and enforcing")
    state = read_state()
    live_elems = live_set_elements() if live else set()
    print_allowed(live, live_elems, state)
    sys.exit(code)


def cmd_status(args):
    brief = getattr(args, "brief", False)
    if not systemd_running():
        return status_container(brief)
    if shutil.which("systemctl", path=SAFE_ENV["PATH"]) is None:
        print("restrict-egress: status unavailable (no systemd on this system)")
        sys.exit(3)
    checks = []

    def unit_ok(unit, verb="is-enabled"):
        return run(["systemctl", verb, unit], check=False).stdout.strip()

    installed = all(os.path.exists(p) for p in (UNIT_BOOT, UNIT_TIMER))
    checks.append(("persistence units installed", installed, ""))
    checks.append(("boot unit enabled", unit_ok("restrict-egress.service") == "enabled", ""))
    checks.append(("boot unit healthy", unit_ok("restrict-egress.service", "is-active") != "failed",
                   "see systemctl status restrict-egress"))
    checks.append(("refresh timer active", unit_ok("restrict-egress-refresh.timer", "is-active") == "active", ""))
    if os.path.isdir(os.path.dirname(DISPATCHER_DIR)):
        checks.append(("network-up hook installed", os.path.exists(DISPATCHER_HOOK), ""))
    if os.geteuid() != 0:
        if brief:
            print(f"restrict-egress: {'installed' if installed else 'inactive'} "
                  "(run as root for enforcement status)")
            sys.exit(0 if installed else 3)
        for name, ok, _ in checks:
            print(f"  [{'ok' if ok else '--'}] {name}")
        print("(run as root for ruleset, allowlist set, and drift detail)")
        sys.exit(0 if installed else 3)

    state = read_state()
    live = table_exists() and chain_enforcing()
    checks.append(("nftables ruleset loaded and enforcing", live, ""))
    uplinks = detect_uplinks()
    checks.append((f"uplinks match ruleset ({','.join(uplinks) or 'none'})",
                   bool(state) and state.get("uplinks") == uplinks, "will self-heal on next refresh"))
    conf_path = state.get("config_path") if state else args.config
    conf_ok, domains_expected = False, True
    try:
        data = read_config_bytes(conf_path)
        conf_ok = bool(state) and hashlib.sha256(data).hexdigest() == state.get("config_sha256")
        domains_expected = bool(parse_config(data.decode("utf-8")).domains)
    except (ConfigError, OSError, UnicodeDecodeError):
        pass
    checks.append(("applied ruleset matches config file", conf_ok, "rerun 'on' or wait for refresh"))
    live_elems = live_set_elements() if live else set()
    if domains_expected:
        checks.append(("allowlist set populated", bool(live_elems), "check DNS and the journal"))

    all_ok = all(ok for _, ok, _ in checks)
    if not installed and not live:
        verdict, code = "inactive", 3
    elif all_ok:
        verdict, code = "active", 0
    else:
        verdict, code = "degraded", 1
    if brief:
        reason = next((name for name, ok, _ in checks if not ok), "")
        print(f"restrict-egress: {verdict}" + (f" ({reason})" if verdict != "active" and reason else ""))
        sys.exit(code)
    print(f"restrict-egress: {verdict}")
    for name, ok, hint in checks:
        print(f"  [{'ok' if ok else '--'}] {name}" + ("" if ok or not hint else f"  ({hint})"))
    print_allowed(live, live_elems, state)
    journal = run(["journalctl", "-t", "restrict-egress", "-n", "3", "--no-pager", "-q"], check=False).stdout
    if journal:
        print("recent log:")
        for line in journal.strip().splitlines():
            print("   " + line)
    sys.exit(code)


# ----------------------------------------------------------------- dry run ----

def dry_run(args, container=False):
    skipped = ["root check", "nft validation", "system mutation"]
    try:
        cfg, _ = load_config(args.config, args.no_allowlist, privileged=False)
    except (ConfigError, OSError) as e:
        sys.exit(f"error: {e}")
    uplinks = detect_uplinks()
    if not container and not uplinks:
        uplinks = ["<uplink>"]
        skipped.append("uplink detection (placeholder shown)")
    elements, failed, _ = resolve_domains(cfg.domains)
    if failed:
        retry = "dropped; apply does not retry" if container else "would retry"
        print(f"# unresolved ({retry}): {', '.join(failed)}")
    print(f"# dry run; skipped: {', '.join(skipped)}")
    if container:
        print(f"# container one-shot: all interfaces restricted, no refresh; "
              f"resolved-domain elements would expire after {cfg.timeout_s}s")
    else:
        print(f"# refresh every {cfg.refresh_s}s, element timeout {cfg.timeout_s}s")
    sys.stdout.write(generate_ruleset(cfg, uplinks, elements, restrict_all=container))


# ------------------------------------------------------------------- main ----

def refresh_entry(args):
    """Timer/hook entry: an active custom --config or kill-switch mode is
    recorded in state and must survive invocations that omit the flags."""
    state = read_state()
    if args.config == DEFAULT_CONF and state and state.get("config_path"):
        args.config = state["config_path"]
    args.no_allowlist = bool(state and state.get("no_allowlist"))
    if args.dry_run:
        dry_run(args)
    else:
        cmd_refresh(args)


def main():
    syslog.openlog("restrict-egress", facility=syslog.LOG_DAEMON)
    parser = argparse.ArgumentParser(
        prog="restrict-egress",
        description="Restrict outbound access to an allowlist of domains and CIDRs "
                    "(nftables default-deny egress). REMnux ships unrestricted; this tool is opt-in.",
        epilog="The lockdown blocks apt and remnux install by design: run "
               "'restrict-egress off' before updating, 'on' after. "
               f"Config: {DEFAULT_CONF} (one domain[:port], IP, or CIDR[:port] per line; "
               "options: dns = open|closed, refresh = 3min, timeout = 30m). "
               "In a container (no systemd), use 'apply' instead of 'on' and run "
               "the container with --cap-add=NET_ADMIN.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument("--config", default=DEFAULT_CONF, help=f"config path (default {DEFAULT_CONF})")
    sub = parser.add_subparsers(dest="command")

    p_on = sub.add_parser("on", help="enable the egress lockdown, persistently")
    p_on.add_argument("--no-allowlist", action="store_true",
                      help="deliberate kill switch: allow nothing outbound (DNS defaults closed)")
    p_on.add_argument("--dry-run", action="store_true", help="print the generated ruleset; change nothing")
    p_on.set_defaults(func=cmd_on)

    p_off = sub.add_parser("off", help="remove the lockdown and restore outbound access")
    p_off.set_defaults(func=cmd_off, no_allowlist=False)

    p_apply = sub.add_parser("apply", help="container one-shot: apply the ruleset without "
                                           "systemd persistence or refresh (needs --cap-add=NET_ADMIN)")
    p_apply.add_argument("--no-allowlist", action="store_true",
                         help="deliberate kill switch: allow nothing outbound (DNS defaults closed)")
    p_apply.add_argument("--dry-run", action="store_true", help="print the generated ruleset; change nothing")
    p_apply.set_defaults(func=cmd_apply)

    p_status = sub.add_parser("status", help="report active / degraded / inactive with checks")
    p_status.set_defaults(func=cmd_status)

    p_refresh = sub.add_parser("refresh", help="re-resolve domains and renew the allow set (timer entry point)")
    p_refresh.add_argument("--reload", action="store_true",
                           help="re-detect uplinks and regenerate the full ruleset (boot/hook entry point)")
    p_refresh.add_argument("--dry-run", action="store_true", help="print the generated ruleset; change nothing")
    p_refresh.set_defaults(func=refresh_entry, no_allowlist=False)

    args = parser.parse_args()
    if args.command is None:
        parser.print_help()
        print("\nCurrent status:")
        args.no_allowlist = False
        args.brief = True  # bare invocation: verdict only, not the full check list
        cmd_status(args)
        return
    args.func(args)


if __name__ == "__main__":
    main()
