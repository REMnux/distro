VERSION = "0.10.1"

INSTALL_PATH = "/usr/local/bin/restrict-egress"
DEFAULT_CONF = "/etc/restrict-egress.conf"
LOCK_PATH = "/run/restrict-egress.lock"
STATE_DIR = "/var/lib/restrict-egress"
STATE_PATH = STATE_DIR + "/state.json"
TABLE = "inet restrict_egress"
SET_NAME = "allow"
DNS_SET_PREFIX = "dns_"      # per-port sets filled by the coupled resolver: dns_443

UNIT_BOOT = "/etc/systemd/system/restrict-egress.service"
UNIT_REFRESH = "/etc/systemd/system/restrict-egress-refresh.service"
UNIT_TIMER = "/etc/systemd/system/restrict-egress-refresh.timer"
UNIT_DNS = "/etc/systemd/system/restrict-egress-dns.service"
DISPATCHER_DIR = "/etc/networkd-dispatcher/routable.d"
DISPATCHER_HOOK = DISPATCHER_DIR + "/50-restrict-egress"

# Coupled-resolver artifacts (written by `on`/reload, removed by `off`).
RESOLVER_DIR = "/etc/restrict-egress"
DNSMASQ_CONF = RESOLVER_DIR + "/dnsmasq.conf"
UPSTREAM_FILE = RESOLVER_DIR + "/upstream.conf"      # dnsmasq servers-file
RESOLVED_DROPIN = "/etc/systemd/resolved.conf.d/restrict-egress.conf"
LOCAL_DNS_ADDR = "127.0.0.1"
LOCAL_DNS_PORT = 5354          # off 53, so fakedns/INetSim/resolved keep their binds

# Subprocesses never inherit the caller's PATH: this tool runs as root.
SAFE_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}

DEFAULT_PORT = 443
DEFAULT_REFRESH_S = 180        # 3min rotation backstop
DEFAULT_TIMEOUT_S = 1800       # 30m element lifetime
REFRESH_MIN_S = 60
TIMEOUT_MIN_S = 300
TIMEOUT_MAX_S = 86400

DOMAIN_RE = re.compile(
    r"^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$",
    re.IGNORECASE,
)
DURATION_RE = re.compile(r"^([0-9]{1,6})\s*(s|sec|m|min|h|hr)?$", re.IGNORECASE)
# Config paths land inside systemd ExecStart= lines and a shell hook; reject
# anything that would need quoting rather than trying to quote it everywhere.
UNSAFE_PATH_RE = re.compile(r"[\s%\"'`$;&<>|\\]")


class ConfigError(Exception):
    pass


def log(msg, error=False):
    syslog.syslog(syslog.LOG_ERR if error else syslog.LOG_INFO, msg)
    if "INVOCATION_ID" in os.environ:
        return  # systemd-invoked: journal already gets the syslog line
    print(("error: " if error else "") + msg, file=sys.stderr if error else sys.stdout)


def run(cmd, input_text=None, check=True):
    return subprocess.run(
        cmd, input=input_text, capture_output=True, text=True, env=SAFE_ENV, check=check
    )


# ---------------------------------------------------------------- config ----

def parse_duration(text, key):
    m = DURATION_RE.match(text.strip())
    if not m:
        raise ConfigError(f"{key}: cannot parse duration '{text}' (use e.g. 90s, 3min, 1h)")
    n, unit = int(m.group(1)), (m.group(2) or "s").lower()
    return n * {"s": 1, "sec": 1, "m": 60, "min": 60, "h": 3600, "hr": 3600}[unit]


class Config:
    def __init__(self):
        self.domains = []      # (name, port)
        self.cidrs = []        # (ipaddress.IPv4Network, port)
        self.dns_open = None   # None = unspecified; resolved by policy checks
        self.refresh_s = DEFAULT_REFRESH_S
        self.timeout_s = DEFAULT_TIMEOUT_S
        self.resolver = "auto"     # auto | local | sampling
        self.upstream = []         # explicit upstream servers for the local resolver

    @property
    def entries(self):
        return len(self.domains) + len(self.cidrs)

    @property
    def domain_ports(self):
        return sorted({port for _, port in self.domains})


def parse_config(text):
    cfg = Config()
    errors = []
    for lineno, raw in enumerate(text.splitlines(), 1):
        line = raw.split("#", 1)[0].strip()
        if not line:
            continue
        if "=" in line:
            key, _, value = line.partition("=")
            key, value = key.strip().lower(), value.strip()
            try:
                if key == "dns":
                    if value.lower() not in ("open", "closed"):
                        raise ConfigError("dns must be 'open' or 'closed'")
                    cfg.dns_open = value.lower() == "open"
                elif key == "refresh":
                    cfg.refresh_s = parse_duration(value, "refresh")
                elif key == "timeout":
                    cfg.timeout_s = parse_duration(value, "timeout")
                elif key == "resolver":
                    if value.lower() not in ("auto", "local", "sampling"):
                        raise ConfigError("resolver must be 'auto', 'local', or 'sampling'")
                    cfg.resolver = value.lower()
                elif key == "upstream":
                    servers = []
                    for item in value.split():
                        try:
                            addr = ipaddress.ip_address(item)
                        except ValueError:
                            raise ConfigError(f"upstream: '{item}' is not an IP address")
                        if addr.version != 4:
                            raise ConfigError("upstream: only IPv4 servers are supported")
                        if addr.is_loopback:
                            raise ConfigError("upstream: a loopback server would loop back into the local resolver")
                        servers.append(str(addr))
                    if not servers:
                        raise ConfigError("upstream: give at least one IPv4 server")
                    cfg.upstream = servers
                else:
                    raise ConfigError(f"unknown option '{key}'")
            except ConfigError as e:
                errors.append(f"line {lineno}: {e}")
            continue
        entry, port = line, DEFAULT_PORT
        if ":" in line:
            entry, _, port_text = line.rpartition(":")
            if not (port_text.isascii() and port_text.isdigit() and 1 <= int(port_text) <= 65535):
                errors.append(f"line {lineno}: bad port '{port_text}'")
                continue
            port = int(port_text)
        try:
            net = ipaddress.ip_network(entry, strict=False)
            if net.version != 4:
                errors.append(f"line {lineno}: only IPv4 CIDRs are supported")
            else:
                cfg.cidrs.append((net, port))
            continue
        except ValueError:
            pass
        if DOMAIN_RE.match(entry):
            cfg.domains.append((entry.lower(), port))
        else:
            errors.append(f"line {lineno}: '{entry}' is neither a domain, IP, nor CIDR")
    if cfg.refresh_s < REFRESH_MIN_S:
        errors.append(f"refresh must be at least {REFRESH_MIN_S}s")
    if not TIMEOUT_MIN_S <= cfg.timeout_s <= TIMEOUT_MAX_S:
        errors.append(f"timeout must be between {TIMEOUT_MIN_S}s and {TIMEOUT_MAX_S}s")
    if cfg.refresh_s > cfg.timeout_s // 3:
        errors.append("refresh must be no more than a third of timeout, or elements expire between refreshes")
    if errors:
        raise ConfigError("; ".join(errors))
    return cfg


def check_policy(cfg, no_allowlist):
    """Cross-field rules ratified in the design. Mutates cfg.dns_open to its default."""
    if no_allowlist and cfg.entries:
        raise ConfigError("--no-allowlist given but the config has allowlist entries; pick one")
    if not no_allowlist and not cfg.entries:
        raise ConfigError(
            "no allowlist entries in the config; add destinations, or use "
            "'on --no-allowlist' for a deliberate egress kill switch"
        )
    if cfg.dns_open is None:
        # Kill switch resolves nothing, so DNS defaults closed there; open otherwise.
        cfg.dns_open = not no_allowlist
    if not cfg.dns_open and cfg.domains:
        raise ConfigError(
            "dns = closed cannot resolve domain entries; use a CIDR-only allowlist "
            "with closed DNS, or set dns = open"
        )
    if no_allowlist and cfg.dns_open:
        log("warning: dns = open leaves port 53 fully usable; this kill switch is not airtight", error=True)
    if cfg.resolver == "local" and not cfg.domains:
        raise ConfigError("resolver = local needs at least one domain entry; there is nothing to couple")


# ------------------------------------------------------ coupled resolver ----

def resolver_prereqs():
    """Why the coupled resolver cannot run here, or None when it can. Needs
    dnsmasq (nftset-capable; every Debian/Ubuntu build since 2.87), systemctl,
    and an active systemd-resolved to route the allowlisted names."""
    if not systemd_running():
        return "no systemd (container or one-shot use)"
    if shutil.which("dnsmasq", path=SAFE_ENV["PATH"]) is None:
        return "dnsmasq not installed"
    if shutil.which("resolvectl", path=SAFE_ENV["PATH"]) is None:
        return "resolvectl not found"
    # Enabled counts, not only active: the boot unit runs before resolved has
    # started, and a mode that flipped to sampling at every boot would tear the
    # resolver artifacts down and rebuild them minutes later on network-up.
    enabled = run(["systemctl", "is-enabled", "systemd-resolved"], check=False).stdout.strip()
    active = run(["systemctl", "is-active", "systemd-resolved"], check=False).stdout.strip()
    if enabled not in ("enabled", "static", "indirect", "alias", "enabled-runtime") and active != "active":
        return "systemd-resolved is not enabled or active"
    return None


def resolvectl(*args):
    """resolvectl stdout, or '' when the binary is missing or the call fails,
    so a host that lost systemd-resolved after enabling the coupled mode
    degrades to 'not routed' instead of a traceback."""
    try:
        return run(["resolvectl"] + list(args), check=False).stdout
    except (FileNotFoundError, OSError):
        return ""


def resolved_global_current():
    """The server resolved is using for the global scope right now, or None
    when it has not picked one yet (fresh start: the first listed is next)."""
    in_global = False
    for line in resolvectl("status").splitlines():
        if line.startswith("Global"):
            in_global = True
            continue
        if line.startswith("Link "):
            in_global = False
        if in_global and "Current DNS Server:" in line:
            return line.split(":", 1)[1].strip()
    return None


def resolver_mode(cfg, container=False):
    """'local' (coupled) or 'sampling'. auto picks local wherever it can run;
    an explicit local that cannot run is a config error, never a silent
    downgrade."""
    if container or not cfg.domains or cfg.resolver == "sampling":
        return "sampling"
    why = resolver_prereqs()
    if why is None:
        return "local"
    if cfg.resolver == "local":
        raise ConfigError(f"resolver = local is not possible here ({why}); use resolver = auto or sampling")
    return "sampling"


def discover_upstreams(cfg, uplinks):
    """Servers the local dnsmasq forwards to: the config's `upstream` list, else
    the uplinks' DNS servers as systemd-resolved knows them (DHCP), else every
    non-loopback server in resolved's compiled resolv.conf. Loopback is always
    dropped: forwarding to resolved would loop straight back to dnsmasq."""
    if cfg.upstream:
        return list(cfg.upstream)
    found = []

    def keep(text):
        # resolved renders servers as IP, IP:PORT, IP%IFACE, or IP#SNI; keep an
        # IPv4 with an optional port (dnsmasq syntax is IP#PORT, see upstream_conf).
        text = text.split("%")[0].split("#")[0]
        host, port = text, None
        if text.count(":") == 1:
            host, _, port_text = text.partition(":")
            port = port_text if port_text.isdigit() and 1 <= int(port_text) <= 65535 else None
            if port is None:
                return
        try:
            addr = ipaddress.ip_address(host)
        except ValueError:
            return
        entry = str(addr) + (f":{port}" if port else "")
        if addr.version == 4 and not addr.is_loopback and entry not in found:
            found.append(entry)

    for link in uplinks:
        out = resolvectl("dns", link)
        # "Link 3 (ens34): 192.168.50.2 10.0.0.1"
        _, _, servers = out.partition(":")
        for tok in servers.split():
            keep(tok)
    if not found:
        try:
            with open("/run/systemd/resolve/resolv.conf") as f:
                for line in f:
                    parts = line.split()
                    if len(parts) >= 2 and parts[0] == "nameserver":
                        keep(parts[1])
        except OSError:
            pass
    return found


def dnsmasq_conf(cfg):
    """One nftset line per port: dnsmasq inserts plain addresses, so each port
    gets its own ipv4_addr set (dns_443, ...) and a matching accept rule.
    cache-size=0: every answer comes from upstream and every answer inserts,
    so a cached record can never outlive its set element. filter-AAAA: the sets
    are IPv4-only, so an AAAA would only give clients an unroutable address to
    fail on (and a misleading 'network unreachable' error). Caveat, verified:
    for a CNAME'd name resolved receives the bare CNAME from dnsmasq and chases
    the target through the uplink's own DNS, so the AAAA still reaches the
    client; harmless where there is no IPv6 route (IPv4 is tried first)."""
    by_port = {}
    for name, port in cfg.domains:
        by_port.setdefault(port, []).append(name)
    lines = [
        "# generated by restrict-egress; edits are overwritten on reload, removed by 'off'",
        f"port={LOCAL_DNS_PORT}",
        f"listen-address={LOCAL_DNS_ADDR}",
        "bind-interfaces",
        "no-resolv",
        f"servers-file={UPSTREAM_FILE}",
        "cache-size=0",
        "no-negcache",
        "filter-AAAA",
        "domain-needed",
        "bogus-priv",
    ]
    for port in sorted(by_port):
        names = "/".join(sorted(set(by_port[port])))
        lines.append(f"nftset=/{names}/4#{TABLE.replace(' ', '#')}#{DNS_SET_PREFIX}{port}")
    return "\n".join(lines) + "\n"


def upstream_conf(servers):
    # resolved spells a port as IP:PORT, dnsmasq as IP#PORT.
    return "".join(f"server={s.replace(':', '#')}\n" for s in servers) or "# no upstream servers found\n"


def resolved_dropin(cfg, servers):
    """Route only the allowlisted names to dnsmasq; list the upstreams after it
    so resolved fails over when dnsmasq is down (verified: 0.01 s failover on
    a refused connection, 10 s failure with no second server)."""
    dns = " ".join([f"{LOCAL_DNS_ADDR}:{LOCAL_DNS_PORT}"] + list(servers))
    domains = " ".join(f"~{name}" for name in sorted({n for n, _ in cfg.domains}))
    return ("# generated by restrict-egress; removed by 'restrict-egress off'\n"
            "[Resolve]\n"
            f"DNS={dns}\n"
            f"Domains={domains}\n")


def unit_dns():
    return f"""[Unit]
Description=restrict-egress: local resolver that couples DNS answers to the allow set
Documentation=file://{INSTALL_PATH}
After=restrict-egress.service network.target
Wants=restrict-egress.service

[Service]
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file={DNSMASQ_CONF} --pid-file=/run/restrict-egress-dns.pid
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=1s

[Install]
WantedBy=multi-user.target
"""


def _read_or_none(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return None


def systemctl_async(*args):
    """Job-queueing systemctl call. Every start/restart/reload issued from inside
    do_reload runs --no-block: the boot unit's ExecStart is do_reload, and the
    dns unit is ordered After= that boot unit, so a blocking restart from there
    would wait on a job that waits on the caller (deadlock until timeout)."""
    return run(["systemctl", "--no-block"] + list(args), check=False)


def resolved_restart():
    """Restart resolved without blocking (see systemctl_async). When it was
    running, wait briefly for it to come back so a lookup issued right after
    (the same reload resolves the allowlist) does not fail on the gap."""
    was_active = run(["systemctl", "is-active", "systemd-resolved"], check=False).stdout.strip() == "active"
    systemctl_async("restart", "systemd-resolved")
    if was_active:
        for _ in range(12):
            time.sleep(0.25)
            if run(["systemctl", "is-active", "systemd-resolved"], check=False).stdout.strip() == "active":
                time.sleep(0.25)  # stub listener settles just after the unit reports active
                break


def apply_local_resolver(cfg, uplinks, first_enable=False):
    """Write/refresh the coupled-resolver artifacts idempotently. Returns the
    upstream list in use. Only a changed drop-in restarts resolved; only a
    changed dnsmasq config restarts dnsmasq; a changed upstream file is a HUP."""
    servers = discover_upstreams(cfg, uplinks)
    os.makedirs(RESOLVER_DIR, mode=0o755, exist_ok=True)
    conf_text = dnsmasq_conf(cfg)
    conf_changed = _read_or_none(DNSMASQ_CONF) != conf_text
    if conf_changed:
        write_file(DNSMASQ_CONF, conf_text, 0o644)
    up_text = upstream_conf(servers)
    up_changed = _read_or_none(UPSTREAM_FILE) != up_text
    if up_changed:
        write_file(UPSTREAM_FILE, up_text, 0o644)
    unit_text = unit_dns()
    unit_changed = _read_or_none(UNIT_DNS) != unit_text
    if unit_changed:
        write_file(UNIT_DNS, unit_text, 0o644)
        run(["systemctl", "daemon-reload"], check=False)
    if first_enable or unit_changed:
        run(["systemctl", "enable", "restrict-egress-dns.service"], check=False)
    def dns_active():
        return run(["systemctl", "is-active", "restrict-egress-dns.service"], check=False).stdout.strip() == "active"

    if conf_changed or unit_changed or not dns_active():
        systemctl_async("restart", "restrict-egress-dns.service")
        # Give the queued (re)start a moment; at boot the unit is ordered after
        # the caller and will not come up inside this wait, which is fine: the
        # network-up hook and the timer re-run this and heal then.
        for _ in range(8):
            if dns_active():
                break
            time.sleep(0.25)
    elif up_changed:
        systemctl_async("reload", "restrict-egress-dns.service")
    dropin_text = resolved_dropin(cfg, servers)
    if _read_or_none(RESOLVED_DROPIN) != dropin_text:
        write_file(RESOLVED_DROPIN, dropin_text, 0o644)
        resolved_restart()
    elif dns_active():
        heal_resolved_current()
    return servers


def heal_resolved_current():
    """resolved switches to the next server when dnsmasq fails and STAYS there
    (it never walks back on its own), which would leave lookups uncoupled after
    a dnsmasq restart or an early-boot lookup. A restart resets it to the first
    server. Call only when dnsmasq is up, so this cannot loop. Returns True
    when a restart was issued."""
    current = resolved_global_current()
    if current and current != f"{LOCAL_DNS_ADDR}:{LOCAL_DNS_PORT}":
        log(f"resolved had moved to {current}; restarting it to re-couple lookups")
        resolved_restart()
        return True
    return False


def remove_local_resolver():
    """Undo apply_local_resolver. Safe to call when nothing was installed."""
    had_dropin = os.path.exists(RESOLVED_DROPIN)
    if systemd_running():
        run(["systemctl", "disable", "restrict-egress-dns.service"], check=False)
        systemctl_async("stop", "restrict-egress-dns.service")
    for path in (UNIT_DNS, DNSMASQ_CONF, UPSTREAM_FILE, RESOLVED_DROPIN):
        try:
            os.unlink(path)
        except OSError:
            pass
    for d in (RESOLVER_DIR, os.path.dirname(RESOLVED_DROPIN)):
        try:
            os.rmdir(d)
        except OSError:
            pass
    if systemd_running():
        run(["systemctl", "daemon-reload"], check=False)
        if had_dropin:
            run(["systemctl", "restart", "systemd-resolved"], check=False)


def resolved_routes_locally():
    """True when systemd-resolved's global scope lists the local dnsmasq."""
    for line in resolvectl("dns").splitlines():
        if line.startswith("Global:") and f"{LOCAL_DNS_ADDR}:{LOCAL_DNS_PORT}" in line:
            return True
    return False


def wait_local_resolver(seconds=8):
    """After an interactive `on`, give the queued dns-unit start and the
    resolved restart a moment so an immediate `status` reports the truth
    rather than 'activating'; then make sure resolved is actually using
    dnsmasq (a lookup that raced the dnsmasq start would have moved it)."""
    healed = False
    for _ in range(seconds * 4):
        if (run(["systemctl", "is-active", "restrict-egress-dns.service"], check=False).stdout.strip() == "active"
                and resolved_routes_locally()):
            if not healed and heal_resolved_current():
                healed = True
                continue
            current = resolved_global_current()
            if current is None or current == f"{LOCAL_DNS_ADDR}:{LOCAL_DNS_PORT}":
                return True
        time.sleep(0.25)
    return False


def local_resolver_installed():
    return os.path.exists(UNIT_DNS) or os.path.exists(RESOLVED_DROPIN)


def read_config_bytes(path, privileged=True):
    """One open, no symlink following, ownership enforced on privileged runs;
    the same bytes feed both the parser and the recorded hash (no TOCTOU)."""
    if not privileged:
        with open(path, "rb") as f:
            return f.read()
    fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
            raise ConfigError(
                f"{path} must be a regular file owned by root and not group/world-writable "
                f"(a config writable by others is allowlist injection); "
                f"fix: chown root:root {path} && chmod 644 {path}"
            )
        return f.read()


def load_config(path, no_allowlist, privileged=True):
    data = read_config_bytes(path, privileged)
    try:
        cfg = parse_config(data.decode("utf-8"))
    except UnicodeDecodeError:
        raise ConfigError(f"{path} is not valid UTF-8 text")
    check_policy(cfg, no_allowlist)
    return cfg, hashlib.sha256(data).hexdigest()


# ------------------------------------------------------------- discovery ----

def detect_uplinks():
    """All interfaces carrying an IPv4 or IPv6 default route; every one gets
    locked, so a second uplink is never a bypass."""
    devs = set()
    for family in ("-4", "-6"):
        try:
            out = run(["ip", "-j", family, "route", "show", "default"]).stdout
            devs.update(r["dev"] for r in json.loads(out) if "dev" in r)
        except (subprocess.CalledProcessError, FileNotFoundError, json.JSONDecodeError, KeyError):
            pass
    return sorted(devs)


def resolve_domains(domains):
    """(name, port) pairs -> (union set of (ip, port), failed names,
    provenance list of (name, ip, port)); resolution follows nsswitch.
    Provenance is kept per name so a CDN IP shared by two allowlisted
    domains is attributed to both, and status can show which name put
    each IP in the set."""
    elements, failed, provenance = set(), [], []
    for name, port in domains:
        try:
            answers = set()
            for info in socket.getaddrinfo(name, port, socket.AF_INET, socket.SOCK_STREAM):
                answers.add((info[4][0], port))
        except OSError:
            failed.append(name)
            continue
        for ip, p in sorted(answers):
            elements.add((ip, p))
            provenance.append((name, ip, p))
    return elements, failed, provenance


# ---------------------------------------------------------------- ruleset ----

def generate_ruleset(cfg, uplinks, elements, restrict_all=False, dns_ports=()):
    lines = [
        f"destroy table {TABLE}",
        f"table {TABLE} {{",
        f"    set {SET_NAME} {{",
        "        type ipv4_addr . inet_service",
        "        flags timeout",
        f"        timeout {cfg.timeout_s}s",
    ]
    if elements:
        rendered = ", ".join(f"{ip} . {port}" for ip, port in sorted(elements))
        lines.append(f"        elements = {{ {rendered} }}")
    lines.append("    }")
    for port in dns_ports:
        # Filled by the coupled resolver (dnsmasq nftset), never by this tool;
        # the set-level timeout applies to what dnsmasq inserts, and each
        # answered lookup renews it.
        lines += [
            f"    set {DNS_SET_PREFIX}{port} {{",
            "        type ipv4_addr",
            "        flags timeout",
            f"        timeout {cfg.timeout_s}s",
            "    }",
        ]
    lines += [
        "    chain output {",
        "        type filter hook output priority 0; policy drop;",
        '        oif "lo" accept',
        # Plain established/related, deliberately: restricting this to
        # 'ct direction reply' freezes flows that predate the ruleset, because
        # conntrack picks such flows up mid-stream and calls whichever packet
        # it sees first "original" -- for a live inbound SSH session that can
        # be the host's own outbound data packet (verified 2026-07-21). The
        # cost: outbound connections opened before 'on' keep working, so
        # enable the lockdown before running untrusted code.
        "        ct state established,related accept",
    ]
    if restrict_all:
        # Container mode: restrict egress on EVERY interface. There is no
        # management NIC to preserve and no refresh to re-detect a moved route,
        # so an uplink-scoped rule (below) would fail open if the default route
        # later shifts to a new interface. Deny all, track no uplinks.
        lines.append("        # container mode: all interfaces restricted, no uplink scoping")
    elif uplinks:
        rendered = ", ".join(f'"{u}"' for u in uplinks)
        lines.append(f"        oifname != {{ {rendered} }} accept")
    else:
        lines.append("        # no default route detected: fail closed, all interfaces restricted")
    lines.append("        udp sport 68 udp dport 67 accept")
    if cfg.dns_open:
        lines.append("        udp dport 53 accept")
        lines.append("        tcp dport 53 accept")
    for net, port in cfg.cidrs:
        lines.append(f"        ip daddr {net} tcp dport {port} accept")
    lines.append(f"        ip daddr . tcp dport @{SET_NAME} accept")
    for port in dns_ports:
        lines.append(f"        ip daddr @{DNS_SET_PREFIX}{port} tcp dport {port} accept")
    lines += [
        "    }",
        "}",
    ]
    return "\n".join(lines) + "\n"


def nft_apply(ruleset):
    """Validate, then swap in one netlink transaction: no accept window, and a
    bad generated ruleset never destroys the running one."""
    with tempfile.NamedTemporaryFile("w", suffix=".nft", delete=False) as f:
        f.write(ruleset)
        path = f.name
    try:
        run(["nft", "-c", "-f", path])
        run(["nft", "-f", path])
    finally:
        os.unlink(path)


def table_exists():
    return run(["nft", "list", "table"] + TABLE.split(), check=False).returncode == 0


def chain_enforcing():
    out = run(["nft", "list", "chain"] + TABLE.split() + ["output"], check=False).stdout
    return "policy drop" in out


def live_set_elements():
    """Live (ip, port) tuples in the allow set, via nft JSON -- robust against
    the text format's per-element timeout decoration that the old line scan
    tripped over. This is the ground truth status intersects provenance against."""
    out = run(["nft", "-j", "list", "set"] + TABLE.split() + [SET_NAME], check=False)
    tuples = set()
    if out.returncode != 0:
        return tuples
    try:
        data = json.loads(out.stdout)
    except (json.JSONDecodeError, ValueError):
        return tuples
    if not isinstance(data, dict):
        return tuples
    for obj in data.get("nftables", []):
        s = obj.get("set") if isinstance(obj, dict) else None
        if not isinstance(s, dict) or s.get("name") != SET_NAME:
            continue
        for el in s.get("elem", []):
            val = el["elem"].get("val") if isinstance(el, dict) and "elem" in el else el
            if isinstance(val, dict) and isinstance(val.get("concat"), list) and len(val["concat"]) == 2:
                ip, port = val["concat"]
                try:
                    tuples.add((str(ip), int(port)))
                except (TypeError, ValueError):
                    pass
    return tuples


def _live_dns_sets():
    """{port: [ip, ...]} for every dns_<port> set in the live table; empty when
    the table or the sets are absent."""
    out = run(["nft", "-j", "list", "table"] + TABLE.split(), check=False)
    sets = {}
    if out.returncode != 0:
        return sets
    try:
        data = json.loads(out.stdout)
    except (json.JSONDecodeError, ValueError):
        return sets
    if not isinstance(data, dict):
        return sets
    for obj in data.get("nftables", []):
        s = obj.get("set") if isinstance(obj, dict) else None
        if not isinstance(s, dict) or not str(s.get("name", "")).startswith(DNS_SET_PREFIX):
            continue
        try:
            port = int(s["name"][len(DNS_SET_PREFIX):])
        except ValueError:
            continue
        ips = sets.setdefault(port, [])
        for el in s.get("elem", []):
            val = el["elem"].get("val") if isinstance(el, dict) and "elem" in el else el
            if isinstance(val, str) and _valid_ip(val):
                ips.append(val)
    return sets


def live_dns_set_ports():
    return sorted(_live_dns_sets())


def live_dns_elements():
    """(ip, port) tuples learned by the coupled resolver."""
    return {(ip, port) for port, ips in _live_dns_sets().items() for ip in ips}


# ------------------------------------------------------------------ state ----

STATE_MAX_BYTES = 1 << 20  # cap the state file we are willing to parse
MAX_RESOLVED = 4096        # cap records so the writer never exceeds the reader's size limit


def _valid_ip(text):
    if not isinstance(text, str):
        return False
    try:
        ipaddress.ip_address(text)
        return True
    except ValueError:
        return False


def _sanitize_resolved(value):
    """Keep only well-formed provenance records; drop anything malformed so a
    corrupted or tampered list degrades to 'provenance unavailable', never to a
    crash or a false attribution. OverflowError guards JSON Infinity, which
    json.loads accepts and int() then rejects."""
    out = []
    if not isinstance(value, list):
        return out
    for rec in value[:MAX_RESOLVED]:
        if not isinstance(rec, dict):
            continue
        try:
            name, ip = rec["name"], rec["ip"]
            port, expires = int(rec["port"]), int(rec["expires"])
        except (KeyError, TypeError, ValueError, OverflowError):
            continue
        if isinstance(name, str) and _valid_ip(ip):
            out.append({"name": name, "ip": ip, "port": port, "expires": expires})
    return out


def _sanitize_cidrs(value):
    out = []
    if not isinstance(value, list):
        return out
    for item in value:
        if isinstance(item, (list, tuple)) and len(item) == 2:
            try:
                out.append([str(item[0]), int(item[1])])
            except (TypeError, ValueError, OverflowError):
                continue
    return out


def read_state():
    """State is written only by this root-run tool. Reject anything that is not
    a root-owned, non-world-writable regular file, never follow a symlink into
    it, and cap the parse size. Malformed or untrusted state is treated as
    absent so the caller reloads rather than trusting bad metadata."""
    try:
        fd = os.open(STATE_PATH, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        return None
    try:
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
                return None
            raw = f.read(STATE_MAX_BYTES + 1)
        if len(raw) > STATE_MAX_BYTES:
            return None
        data = json.loads(raw.decode("utf-8"))
    except (OSError, json.JSONDecodeError, UnicodeDecodeError):
        return None
    if (isinstance(data, dict) and data.get("owner") == "restrict-egress"
            and isinstance(data.get("config_path"), str)
            and "\x00" not in data["config_path"]
            and isinstance(data.get("uplinks"), list)):
        data["resolved"] = _sanitize_resolved(data.get("resolved"))
        data["cidrs"] = _sanitize_cidrs(data.get("cidrs"))
        return data
    return None  # malformed state is treated as absent (fail toward reload)


def write_state(conf_path, conf_sha, no_allowlist, uplinks, refresh_s, resolved, cidrs,
                resolver="sampling", upstreams=()):
    os.makedirs(STATE_DIR, mode=0o755, exist_ok=True)
    data = {
        "owner": "restrict-egress",
        "version": VERSION,
        "config_path": conf_path,
        "config_sha256": conf_sha,
        "no_allowlist": no_allowlist,
        "uplinks": uplinks,
        "refresh_s": refresh_s,
        "resolved": resolved,
        "cidrs": cidrs,
        "resolver": resolver if resolver in ("local", "sampling") else "sampling",
        "upstreams": [s for s in upstreams if _valid_ip(s)],
    }
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR)
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.replace(tmp, STATE_PATH)


def cidr_records(cfg):
    """Static CIDRs as applied, so status shows them without re-reading config
    (which could have drifted from what is actually enforced)."""
    return [[str(net), port] for net, port in cfg.cidrs]


def _records_from_keys(by_key):
    """Build a sorted, capped record list from a {(name,ip,port): expires} map.
    When over cap, the newest expiries win (the freshest attributions)."""
    items = sorted(by_key.items(), key=lambda kv: kv[1], reverse=True)[:MAX_RESOLVED]
    out = [{"name": n, "ip": ip, "port": port, "expires": exp}
           for (n, ip, port), exp in items]
    out.sort(key=lambda r: (r["name"], r["port"], r["ip"]))
    return out


def resolved_records(provenance, timeout_s, now):
    """Fresh provenance for a full reload: the table was replaced, so only this
    resolution is live. Keyed to dedupe duplicate config lines (which would
    otherwise inflate the shared-IP count)."""
    expires = int(now + timeout_s)
    return _records_from_keys({(n, ip, port): expires for (n, ip, port) in provenance})


def merge_resolved(prior, provenance, timeout_s, now):
    """A plain refresh leaves rotated-out IPs live until their nft timeout, so
    their attribution must survive too: renew records seen this tick, keep prior
    records that are still unexpired, prune the rest. Keyed per (name, ip, port)
    so a shared IP renews independently for each domain that resolves to it."""
    expires = int(now + timeout_s)
    by_key = {(r["name"], r["ip"], int(r["port"])): int(r["expires"])
              for r in prior if int(r["expires"]) > now}
    for name, ip, port in provenance:
        by_key[(name, ip, port)] = expires
    return _records_from_keys(by_key)


class Lock:
    def __enter__(self):
        self.f = open(LOCK_PATH, "w")
        fcntl.flock(self.f, fcntl.LOCK_EX)
        return self

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


