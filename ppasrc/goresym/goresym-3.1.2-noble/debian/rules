#!/usr/bin/make -f
# Upstream publishes no Linux arm64 build, so this package builds GoReSym for arm64; REMnux keeps
# installing upstream's release binary on amd64. The Go module sources ship in the vendor
# component tarball (made with `go mod vendor` and checked with `go mod verify`), because
# Launchpad builders have no network.
export PATH := /usr/lib/go-1.22/bin:$(PATH)
export GOCACHE := $(CURDIR)/debian/.gocache
export GOPATH := $(CURDIR)/debian/.gopath
export GOTOOLCHAIN := local
export GOFLAGS := -mod=vendor -trimpath -buildvcs=false

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@

override_dh_auto_build:
	# Same flags as upstream's release workflow, so -about reports the release version.
	go build -ldflags="-X main.Version=v$(DEB_VERSION_UPSTREAM)" -o GoReSym .

override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 GoReSym debian/goresym/usr/bin/GoReSym

override_dh_dwz:

override_dh_auto_clean:
	rm -rf GoReSym debian/.gocache debian/.gopath
